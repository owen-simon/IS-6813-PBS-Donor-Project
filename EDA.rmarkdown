## Setup

```{r}
library(dplyr)
library(gt)
library(readr)
library(stringr)
library(sf)
library(ggplot2)
library(tigris)

options(tigris_use_cache = TRUE)
```

## Constituent Data

### Load Data

```{r}
# Load membership data
memberships <- read_csv(
  "Data_Files/constituents_w_memberships.csv",
  show_col_types = FALSE
)

team_approach <- read_csv(
  "Data_Files/team_approach_legacy_payments.csv",
  show_col_types = FALSE
)
```

```{r}
# Select unique `Constituent_ID` and `Zipcode` from Constituents (Membership) data
membership_locations <- memberships %>%
  select(
    `Constituent ID`,
    `Address ZIP`
  ) %>%
  rename(
    Constituent_ID = `Constituent ID`,
    Zipcode = `Address ZIP`
  ) %>%
  mutate(
    Constituent_ID = as.character(Constituent_ID),
    Zipcode = as.character(Zipcode),
    Zipcode = str_extract(Zipcode, "\\d{5}")
  ) %>%
  filter(
    !is.na(Constituent_ID),
    !is.na(Zipcode)
  ) %>%
  distinct(
    Constituent_ID,
    Zipcode
  )
```

```{r}
# Select unique `Constituent_ID` and `Zipcode` from Team Approach data
team_approach_locations <- team_approach %>%
  select(
    constituent_id_1,
    zip
  ) %>%
  rename(
    Constituent_ID = constituent_id_1,
    Zipcode = zip
  ) %>%
  mutate(
    Constituent_ID = as.character(Constituent_ID),
    Zipcode = as.character(Zipcode),
    Zipcode = str_extract(Zipcode, "\\d{5}")
  ) %>%
  filter(
    !is.na(Constituent_ID),
    !is.na(Zipcode)
  ) %>%
  distinct(
    Constituent_ID,
    Zipcode
  )
```

```{r}
#---------------------------------------------------------------------
# Merge membership and legacy zipcode information into singular df
# Give current membership zipcodes priority over legacy ZIP codes
# Combine both sources
#---------------------------------------------------------------------
membership_locations <- membership_locations %>%
  mutate(Source = "Membership")

team_approach_locations <- team_approach_locations %>%
  mutate(Source = "Team Approach")

constituent_locations <- bind_rows(
  membership_locations,
  team_approach_locations
) %>%
  arrange(
    Constituent_ID,
    factor(
      Source,
      levels = c(
        "Membership",
        "Team Approach"
      )
    )
  ) %>%
  distinct(
    Constituent_ID,
    .keep_all = TRUE
  )
```

### Geographic Summary

```{r}
# Summary of combined geographic data
membership_count <- n_distinct(
  membership_locations$Constituent_ID
)

cat(
  "Membership constituents with zipcodes:",
  format(membership_count, big.mark = ","),
  "\n"
)

team_approach_count <- n_distinct(
  team_approach_locations$Constituent_ID
)

cat(
  "Team Approach constituents with zipcodes:",
  format(team_approach_count, big.mark = ","),
  "\n"
)

total_locations <- n_distinct(
  constituent_locations$Constituent_ID
)


cat(
  "Combined unique constituents with zipcodes:",
  format(total_locations, big.mark = ","),
  "\n"
)

unique_zipcodes <- n_distinct(
  constituent_locations$Zipcode
)

cat(
  "Unique ZIP codes:",
  format(unique_zipcodes, big.mark = ","),
  "\n"
)
```

### Count Constituents by Zipcode

```{r}
# Count unique constituents by Zipcode
zip_counts <- constituent_locations %>%
  group_by(Zipcode) %>%
  summarise(
    `Constituent Count` = n_distinct(Constituent_ID),
    .groups = "drop"
  ) %>%
  arrange(
    desc(`Constituent Count`)
  )

gt(head(zip_counts, 10))
```

### Utah Constituent Map

```{r}
# Download 2020 U.S. ZIP Code Tabulation Areas
us_zctas <- zctas(
  year = 2020,
  cb = TRUE
)

# Download Utah state boundary
utah_boundary <- states(
  cb = TRUE,
  year = 2020
) %>%
  filter(STUSPS == "UT")

# Make sure both layers use the same coordinate system
utah_boundary <- st_transform(
  utah_boundary,
  st_crs(us_zctas)
)

# Identify ZCTAs that intersect Utah
utah_zctas <- us_zctas[
  lengths(
    st_intersects(
      us_zctas,
      utah_boundary
    )
  ) > 0,
]

cat(
  "Utah ZIP Code Tabulation Areas:",
  nrow(utah_zctas),
  "\n"
)
```

```{r}
# Merge constituent counts with Utah ZIP boundaries
utah_constituent_map <- utah_zctas %>%
  left_join(
    zip_counts,
    by = c("ZCTA5CE20" = "Zipcode")
  )

# Keep ZIP codes containing constituents
matched_utah_zips <- utah_constituent_map %>%
  filter(!is.na(`Constituent Count`))

# Calculate number of constituents represented in Utah
utah_constituents <- sum(
  matched_utah_zips$`Constituent Count`,
  na.rm = TRUE
)

# Calculate percent of combined constituents represented in Utah
utah_constituent_pct <- (
  utah_constituents / total_locations
) * 100

cat(
  "Utah ZIP codes with constituents:",
  nrow(matched_utah_zips),
  "\n"
)

cat(
  "Utah constituents represented on map:",
  format(
    utah_constituents,
    big.mark = ","
  ),
  "\n"
)

cat(
  "Percent of combined constituents represented in Utah:",
  round(
    utah_constituent_pct,
    1
  ),
  "%\n"
)
```

```{r}
# Plot Utah constituent distribution
ggplot() +
  geom_sf(
    data = utah_constituent_map,
    aes(fill = `Constituent Count`),
    color = "white",
    linewidth = 0.1
  ) +
  scale_fill_gradient(
    low = "lightblue",
    high = "darkblue",
    na.value = "grey95",
    name = "Constituent Count"
  ) +
  geom_sf(
    data = utah_boundary,
    fill = NA,
    color = "black",
    linewidth = 0.5
  ) +
  labs(
    title = "Geographic Distribution of PBS Utah Constituents",
    subtitle = "Unique Constituents by Zipcode"
  ) +
  theme_void() +
  theme(
    plot.title = element_text(
      size = 16,
      face = "bold",
      hjust = 0.5
    ),
    plot.subtitle = element_text(
      size = 11,
      hjust = 0.5
    ),
    legend.position = "right"
  )
```

```{r}
#| echo: false
# remove unnecessary items from memory
rm(
  constituent_locations,
  matched_utah_zips,
  membership_locations,
  team_approach_locations,
  us_zctas,
  utah_boundary,
  utah_constituent_map,
  utah_zctas,
  zip_counts,
  membership_count,
  team_approach_count,
  total_locations,
  unique_zipcodes,
  memberships,
  team_approach
)
```

## Passport Viewing Data

### Load Data

```{r}
# Load Passport viewing data
passport <- read_csv(
  "Data_Files/passport_viewing_data.csv",
  show_col_types = FALSE
)
```

### Data Overview

```{r}
cat(
  "Viewing records:",
  format(nrow(passport), big.mark = ","),
  "\n"
)

cat(
  "Unique Passport accounts:",
  format(
    n_distinct(passport$UID),
    big.mark = ","
  ),
  "\n"
)

cat(
  "Unique constituents:",
  format(
    n_distinct(passport$`Constituent.ID`),
    big.mark = ","
  ),
  "\n"
)

cat(
  "Unique series:",
  format(
    n_distinct(passport$`Content.Channel`),
    big.mark = ","
  ),
  "\n"
)
```

### Clean Data

```{r}
# Rename Passport title columns
passport <- passport %>%
  rename(
    Series_Title = `Content.Channel`,
    Episode_Title = Title
  )
```

### Series Reach and Viewing

```{r}
# Calculate total number of unique Passport accounts
total_accounts <- n_distinct(passport$UID)

# Aggregate viewing activity by series
show_summary <- passport %>%
  group_by(Series_Title) %>%
  summarise(
    Reach = n_distinct(UID),
    total_watch_time_seconds = sum(
      `Time.Watched`,
      na.rm = TRUE
    ),
    `Avg. Completion (%)` = mean(
      `Percent.Watched`,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  mutate(
    `Reach (%)` = round(
      Reach / total_accounts * 100,
      2
    ),
    `Watch Time (Hrs)` = round(
      total_watch_time_seconds / 3600,
      2
    ),
    `Avg. Completion (%)` = round(
      100 * `Avg. Completion (%)`,
      2
    )
  ) %>%
  select(
    Series_Title,
    Reach,
    `Reach (%)`,
    `Watch Time (Hrs)`,
    `Avg. Completion (%)`
  ) %>%
  arrange(
    desc(Reach),
    desc(`Watch Time (Hrs)`)
  )
```

### Series Summary

```{r}
# Display full series summary
gt(head(show_summary, 10))
```

```{r}
cat(
  "<strong>Note:</strong> Only",
  sum(show_summary$`Reach (%)` > 10, na.rm = TRUE),
  "out of the",
  n_distinct(passport$Series_Title),
  "unique series on PBS Passport have been viewed by at least 10% of accounts."
)
```
